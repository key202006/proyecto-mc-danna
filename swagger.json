          "200": {
            "description": "Lista de personas"
          }
        }
      },

      "post": {
        "tags": ["Personas"],
        "summary": "Crear persona",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "primer nombre": {
                    "type": "string"
                  },
                  "segundo nombre": {
                    "type": "string"
                  },
                  "primer apellido": {
                    "type": "string"
                  },
                  "segundo apellido": {
                    "type": "string"
                  },
                  "documento": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persona creada"
          }
        }
      }
    },

